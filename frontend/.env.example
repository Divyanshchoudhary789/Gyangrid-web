# Copy to .env and fill in. Never commit .env.

# Backend
# false -> real backend (default for all real environments)
# true  -> in-browser mock API in src/services/mock (local demo only)
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=https://<your-backend-host>/api/v1

# Firebase Web SDK (Authentication) — from Firebase console → Project settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Only used when VITE_USE_MOCK_API=true
VITE_MOCK_LATENCY_MS=350
